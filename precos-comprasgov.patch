+      </Panel>
+
+      {/* ── Top variação geral ──────────────────────────────────────────────── */}
+      <Panel
+        icon={<TrendingUp className="h-4 w-4" />}
+        title="Medicamentos com maior variação de preço (geral)"
+        subtitle="Top itens por razão preço máximo / preço mínimo — mínimo de 5 compras registradas. Clique para analisar."
+      >
+        <Table>
