+    const arr = Array.from(byMat, ([material, diff]) => ({ material, diff }));
+    const top = arr.filter((d) => d.diff > 0).sort((a, b) => b.diff - a.diff).slice(0, topN);
+    const bottom = arr.filter((d) => d.diff < 0).sort((a, b) => a.diff - b.diff).slice(0, topN);
+    return { top, bottom };
+  }, [comPmvg, topN]);
