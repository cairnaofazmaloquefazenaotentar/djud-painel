generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "sismat"]
}

// Auth.js standard entities
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(OPERATOR)
  organizationId String?
  organization  Organization? @relation(fields: [organizationId], references: [id])

  accounts                Account[]
  sessions                Session[]
  auditLogs               AuditLog[]
  demandasResponsavel     Demanda[]  @relation("DemandaResponsavel")
  demandasCriadas         Demanda[]  @relation("DemandaCriadoPor")
  demandasAtualizadas     Demanda[]  @relation("DemandaAtualizadoPor")
  attachments             Attachment[] @relation("UserAttachments")
  relatoriosGerados       RelatorioGerado[]
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  @@index([organizationId])
  @@index([email])
  @@schema("public")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@schema("public")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("public")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@schema("public")
}

// Backoffice entities
enum UserRole {
  ADMIN
  MANAGER
  OPERATOR

  @@schema("public")
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  logoUrl   String?
  active    Boolean   @default(true)
  users     User[]
  demandas  Demanda[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([slug])
  @@schema("public")
}

model Role {
  id          String       @id @default(cuid())
  name        UserRole
  description String?
  permissions Permission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([name])
  @@schema("public")
}

model Permission {
  id      String @id @default(cuid())
  action  String // e.g., "demandas:read", "users:write"
  roleId  String
  role    Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([action, roleId])
  @@index([roleId])
  @@schema("public")
}

// DJUD-specific entities
enum FormaCumprimento {
  AQUISICAO_DJUD
  DEPOSITO_JUDICIAL
  ENTREGA_CEAF

  @@schema("public")
}

model Demanda {
  id                           String            @id @default(cuid())
  numero                       String            @unique
  titulo                       String
  descricao                    String            @db.Text
  projeto                      String?
  ano                          Int?
  origemDemanda                String?
  status                       String?
  prioridade                   String?
  pontoControle                String?
  trfRegiao                    Int?
  ufResidencia                 String?
  ufOcorrencia                 String?
  municipio                    String?
  tipoRepresentacaoJudicial    String?
  areaTematicaConsultor        String?
  areaFinalisticaMs            String?

  // Novos campos do Excel (Sprint 8)
  numeroExterno                String?          // ID original Redmine
  areaTematica                 String?          // Grupo Temático (Medicamentos Oncológicos, etc)
  regiaoBrasil                 String?          // Região Brasil (Norte, Nordeste, Centro-Oeste, Sudeste, Sul)
  objetoAcao                   String?          // Objeto da Ação (Medicamento - Oncológico, etc)
  principioAtivo               String?          // Princípio_Ativo / Medicamento (nome do medicamento)
  fornecedor                   String?          // Fornecedor/laboratório do medicamento (preenchido quando a base trouxer essa coluna)
  autor                        String?          // Autor(a) da ação judicial (paciente/requerente)
  numeroProcesso               String?          // Ação Judicial Originário (ex: 5000904-02.2021.4.03.6006)
  dataEntradaDJUD              DateTime?        // Data de Entrada no DJUD

  formaCumprimento             FormaCumprimento?
  valorEstimado                Decimal?
  dataInicio                   DateTime?
  dataVencimento               DateTime?
  organizacaoId                String?
  organizacao                  Organization?     @relation(fields: [organizacaoId], references: [id], onDelete: SetNull)
  responsavelId                String?
  responsavel                  User?             @relation("DemandaResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  criadoPorId                  String
  criadoPor                    User              @relation("DemandaCriadoPor", fields: [criadoPorId], references: [id], onDelete: Restrict)
  atualizadoPorId              String?
  atualizadoPor                User?             @relation("DemandaAtualizadoPor", fields: [atualizadoPorId], references: [id], onDelete: SetNull)
  tags                         String[]
  metadados                    Json?
  criadoEm                     DateTime          @default(now())
  atualizadoEm                 DateTime          @updatedAt
  // Soft delete — demandas ficam 30 dias em "lixeira" antes de serem purgadas
  deletedAt                    DateTime?
  attachments                  Attachment[]

  @@index([ano])
  @@index([formaCumprimento])
  @@index([trfRegiao])
  @@index([ufResidencia])
  @@index([status])
  @@index([prioridade])
  @@index([organizacaoId])
  @@index([responsavelId])
  @@index([criadoPorId])
  @@index([areaTematica])
  @@index([numeroProcesso])
  @@index([numeroExterno])
  @@index([regiaoBrasil])
  @@index([fornecedor])
  @@index([autor])
  @@index([deletedAt])
  @@schema("public")
}

model Attachment {
  id           String   @id @default(cuid())
  demandaId    String
  demanda      Demanda  @relation(fields: [demandaId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  fileSize     Int
  storagePath  String
  uploadedAt   DateTime @default(now())
  uploadedById String
  uploadedBy   User     @relation("UserAttachments", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([demandaId])
  @@index([uploadedById])
  @@schema("public")
}

model DataSource {
  id              String   @id @default(cuid())
  fileName        String
  importedAt      DateTime @default(now())
  importedByUserId String
  rowCount        Int
  sha256          String   @unique
  schemaVersion   String   @default("1.0")
  status          String   @default("ACTIVE") // ACTIVE, ARCHIVED, FAILED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([sha256])
  @@schema("public")
}

model UserView {
  id         String   @id @default(cuid())
  userId     String
  name       String
  querystring String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@schema("public")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // CREATE, READ, UPDATE, DELETE, LOGIN, EXPORT, IMPORT
  entity    String   // Demanda, User, Organization, Role
  entityId  String?
  changes   Json?    // before/after values for updates
  metadata  Json?    // additional context
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────────
// SISMAT — entradas de material (compras/estoque) importadas do SISMAT_entradas.csv
// Vive em schema Postgres dedicado "sismat", separado do "public" (Redmine/app).
// É um espelho fiel da base: TODAS as movimentações são importadas cruas; o recorte
// de "gastos" (só aquisições) é aplicado na camada de consulta, não aqui.
// ─────────────────────────────────────────────────────────────────────────────
model SismatEntrada {
  id                  String    @id @default(cuid())

  siafi               Int?      // Código SIAFI da unidade (ex: 309, 336)
  material            String    // Material bruto: "0860921 - VENETOCLAX 100MG COMPRIMIDO"
  materialNome        String?   // Nome normalizado (princípio ativo): "VENETOCLAX"
  dtArmazenamento     DateTime? // Dt. Armaz.
  dtValidade          DateTime? // Dt. Validade
  progSaude           String?   // Prog Saúde (ex: "DEMANDA JUDICIAL - Aquisi")
  unidade             String?   // Unid (COMP., FR., etc)
  quantidade          Float?    // Quantidade
  valorUnitario       Decimal?  // Valor Unitário (formato inglês no CSV: ponto decimal)
  valorTotal          Decimal?  // Valor Total — base para os gráficos de gasto
  nLote               String?   // N Lote
  fornecedor          String?   // Fornecedor
  contrato            String?   // Contrato
  empenhoDoc          String?   // Empenho/Doc
  dtRecebimento       DateTime? // Dt. Recebimento — dirige a série temporal do dashboard
  notaFiscalDoc       String?   // Nota Fiscal/Doc
  statusArmazenamento String?   // Status Armazenamento (ex: "ARMAZENADO")
  numeroOrdem         String?   // Nº de Ordem
  distribuidor        String?   // Distribuidor
  fabricante          String?   // Fabricante
  tipoMovimentacao    String?   // Tipo de Movimentação (ENTRADA ORÇAMENTÁRIA, EXTRA-ORÇ. / AQUISIÇÃO, etc)

  criadoEm            DateTime  @default(now())

  @@index([fornecedor])
  @@index([fabricante])
  @@index([distribuidor])
  @@index([materialNome])
  @@index([tipoMovimentacao])
  @@index([dtRecebimento])
  @@schema("sismat")
}

// ─────────────────────────────────────────────────────────────────────────────
// SISMAT — saídas de material (entregas/baixas) importadas de
// "Demanda_Judicial_-_Saidas.xlsx". Espelho fiel: TODAS as linhas são
// importadas cruas (inclui devoluções); o recorte de "saídas efetivas"
// (Programa Saúde = Aquisição) é aplicado na camada de consulta.
// Granularidade temporal: MENSAL ("Mês e Ano Baixa" não tem dia; dtBaixa
// recebe o 1º dia do mês, em UTC).
// ─────────────────────────────────────────────────────────────────────────────
model SismatSaida {
  id                 String    @id @default(cuid())

  material           String    // Material bruto: "ABEMACICLIBE  50MG - COMPRIMIDO" (sem código prefixo)
  materialCodigo     String?   // Código BR/CATMAT (coluna sem cabeçalho B, quando presente)
  materialNome       String?   // Nome normalizado (princípio ativo): "ABEMACICLIBE" — chave de cruzamento com entradas
  progSaude          String?   // "DEMANDA JUDICIAL - Aquisição" | "DEMANDA JUDICIAL - Devolução"
  fornecedor         String?   // Fornecedor
  destinatario       String?   // Entidade/Destinatário (autor da ação + nº SEI)
  destinatarioCodigo String?   // Código do destinatário (coluna sem cabeçalho F)
  esfera             String?   // Esfera Administrativa (FEDERAL, PARTICULAR, ESTADUAL, …)
  ufNome             String?   // UF por extenso ("SAO PAULO")
  uf                 String?   // Sigla da UF ("SP"; "NI" = não informado)
  tipoDestinatario   String?   // Tipo Entidade/Destinatário (AUTARQUIA, ENTIDADE PRIVADA, …)
  mesAnoBaixa        String?   // Valor original ("MAI 2025") — preservado para auditoria
  dtBaixa            DateTime? // 1º dia do mês da baixa (UTC) — dirige as séries temporais
  qtdEntregue        Float?    // Qtd Entregue
  qtdPedido          Float?    // Qtd Pedido
  valorItem          Decimal?  // Vlr Item Saída (unitário)
  valorTotal         Decimal?  // Valor Total Saída — base dos gráficos

  criadoEm           DateTime  @default(now())

  @@index([fornecedor])
  @@index([materialNome])
  @@index([uf])
  @@index([tipoDestinatario])
  @@index([progSaude])
  @@index([dtBaixa])
  @@schema("sismat")
}

// ─────────────────────────────────────────────────────────────────────────────
// ComprasGov — preços praticados em compras públicas de medicamentos
// (base histórica 2018–2025 extraída de "dashboard_ComprasGov_Jud.html").
// Cada linha é UMA compra: medicamento × unidade de fornecimento, com esfera
// administrativa, modalidade de compra, marcador Judicial/Não Judicial, data,
// quantidade, valor total e preço unitário. Alimenta a aba "Preços" do painel
// (comparativo dos preços praticados — compras judiciais vs. administrativas).
// ─────────────────────────────────────────────────────────────────────────────
model ComprasGovPreco {
  id            Int      @id      // id do registro na base de origem (estável — usado p/ ocultar outliers)

  material      String            // Medicamento (ex: "VENETOCLAX")
  unidade       String            // Unidade de fornecimento (ex: "COMPRIMIDO", "FRASCO 5 ML")
  esfera        String            // Esfera Unid Participante: Federal | Estadual | Municipal
  modalidade    String            // Modalidade: Pregão | Dispensa de Licitação | Inexigibilidade de Licitação
  judicial      String            // "Judicial" | "Não Judicial"
  dtCompra      DateTime          // Data da compra (UTC, meia-noite)
  quantidade    Float             // Quantidade adquirida
  valorTotal    Decimal           // Valor total da compra (R$)
  precoUnitario Decimal           // Preço unitário praticado (R$) — eixo Y do gráfico

  criadoEm      DateTime @default(now())

  @@index([material, unidade])
  @@index([dtCompra])
  @@index([judicial])
  @@schema("sismat")
}

// ─────────────────────────────────────────────────────────────────────────────
// SISMAT × PMVG — preço unitário pago (SISMAT) vs. preço PMVG vigente na data
// de entrega (aba "Preços" › sub-aba PMVG). 1 linha por compra do SISMAT, já
// pareada (fuzzy-match texto/fabricante, rank 1) com a foto mensal do PMVG
// mais recente com competência ≤ à data de entrega.
//   • pmvgPrecos: array com o preço de EMBALAGEM em cada alíquota do PMVG, na
//     MESMA ordem de PMVG_COLS (lib/pmvg-metrics.ts). null = alíquota sem valor.
//   • O preço PMVG unitário é derivado no cliente (embalagem ÷ qtdEmbalagem),
//     como no dashboard de origem — nada de alíquota é escolhido no servidor.
// ─────────────────────────────────────────────────────────────────────────────
model SismatPmvg {
  id              Int      @id @default(autoincrement())

  material        String            // Material comprado (texto do SISMAT)
  subMaterial     String            // Medicamento/princípio ativo pareado (PMVG)
  fabricante      String            // Fabricante da compra
  dtEntrega       DateTime          // Data de entrega (UTC, meia-noite) — eixo X
  quantidade      Float             // Quantidade de unidades adquirida
  valorUnitario   Decimal           // Preço unitário PAGO (R$) — eixo Y (pago)
  valorTotal      Decimal           // Valor total da compra (R$)
  score           Float             // Confiança do match texto/fabricante (0–100)
  qtdEmbalagem    Float             // Unidades por embalagem estimadas (divisor do PMVG)
  metodoQtd       String            // Heurística da qtd/emb.: leading_count | trailing_x | default_single
  pmvgCompetencia DateTime?         // Competência do PMVG usado (1º dia do mês) — null se não encontrado
  apresentacao    String?           // Texto da apresentação do PMVG pareado
  pmvgPrecos      Json              // Preço de embalagem por alíquota (ordem de PMVG_COLS; null onde ausente)

  criadoEm        DateTime @default(now())

  @@index([material])
  @@index([dtEntrega])
  @@index([fabricante])
  @@schema("sismat")
}

// ─────────────────────────────────────────────────────────────────────────────
// Redmine × SISMAT — atributos da demanda por nº SEI (NUP)
// Tabela de apoio (1 linha por "NUP_SEI Principal") extraída da base Redmine
// (baseRedmine_*.xlsx) pelo scripts/import-redmine-sei.ts. Alimenta o dashboard
// de Saídas: cada saída do SISMAT é cruzada com estes atributos pelo nº SEI
// embutido no final do campo destinatario ("FULANO DE TAL 00737.001234/2020-11").
// Regra de consolidação: 1ª ocorrência NÃO-VAZIA de cada campo, na ordem do
// arquivo (réplica do dashboard_redmine_sismat.html de referência).
// ─────────────────────────────────────────────────────────────────────────────
model RedmineSeiAtributos {
  sei                  String   @id      // NUP_SEI Principal ("00737.001234/2020-11")

  crm                  String?           // Nº CRM do prescritor (sem separador de milhar)
  ufCrm                String?           // UF do CRM do prescritor
  oab                  String?           // Nº OAB do advogado (sem separador de milhar)
  ufOab                String?           // UF da OAB do advogado
  grupoTematico        String?           // Grupo Temático (Medicamentos Gerais, Alto Impacto…)
  regiaoBrasil         String?           // Região Brasil (Norte, Nordeste, …)
  ufResidencia         String?           // UF_Residência do autor
  formaCumprimento     String?           // Aquisição DJUD | Depósito Judicial | Entrega CEAF
  modalidadeTratamento String?           // Contínuo | Único
  statusAbastecimento  String?           // Abastecido | Desabastecido | Não Informado
  statusRedmine        String?           // coluna `status` do Redmine (Em Análise COAJUD, …)
  autor                String?           // Autor(a) da ação judicial (paciente/requerente) — coluna "Autor(a)"
  trfRegiao            Int?              // Região TRF (1–6) — coluna "TRF Região"

  criadoEm             DateTime @default(now())

  @@index([grupoTematico])
  @@index([regiaoBrasil])
  @@index([statusRedmine])
  @@index([trfRegiao])
  @@schema("sismat")
}

// ─── Bases de Preços ─────────────────────────────────────────────────────────

model PrecoCmed {
  id              String   @id @default(cuid())
  substancia      String
  substanciaNorm  String
  produto         String
  apresentacao    String
  laboratorio     String?
  cnpj            String?
  codigoGgrem     String?
  registro        String?
  classeTerap     String?
  tipoProduto     String?
  regimePreco     String?
  pfSemImpostos   Float?
  pf0             Float?
  pf12            Float?
  pf17            Float?
  pf18            Float?
  pmvgSemImpostos Float
  pmvg0           Float?
  pmvg12          Float?
  pmvg17          Float?
  pmvg18          Float?
  cap             Boolean  @default(false)
  confaz87        Boolean  @default(false)
  icms0           Boolean  @default(false)
  comercializacao String?
  tarja           String?
  vigencia        DateTime @default(now())

  @@index([substanciaNorm])
  @@index([substancia])
  @@schema("public")
}

model PrecoBps {
  id              String    @id @default(cuid())
  codigoCatmat    String
  descricao       String
  nomeNorm        String
  unidade         String?
  generico        Boolean?
  preco           Float
  qtd             Float
  valorTotal      Float?
  modalidade      String?
  data            DateTime
  uf              String?
  municipio       String?
  instituicao     String?
  cnpjInstituicao String?
  fabricante      String?
  fornecedor      String?
  cnpjFornecedor  String?
  anoBase         Int

  @@index([nomeNorm])
  @@index([data])
  @@index([uf])
  @@index([anoBase])
  @@index([codigoCatmat])
  @@schema("public")
}

model PrecoSiasg {
  id             String    @id @default(cuid())
  codigoCatmat   String
  descricao      String
  nomeNorm       String
  unidade        String?
  unidadeNorm    String?
  formaApres     String?
  preco          Float
  qtd            Float
  valorTotal     Float?
  modalidade     String?
  data           DateTime
  ano            Int
  uf             String?
  municipio      String?
  orgaoSup       String?
  orgao          String?
  esfera         String?
  fornecedor     String?
  cnpjFornecedor String?
  fabricante     String?
  marca          String?
