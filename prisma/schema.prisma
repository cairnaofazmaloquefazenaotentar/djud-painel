  @@index([nomeNorm])
  @@index([acaoJudicial])
  @@index([ano])
  @@index([uf])
  @@index([codigoCatmat])
  @@schema("public")
}

model PrecoPncp {
  id                  String    @id @default(cuid())
  codItemCatalogo     String?
  descricaoResumida   String
  descricaoNorm       String
  descricaoDetalhada  String?   @db.Text
  unidade             String?
  quantidade          Float?
  valorUnitEstimado   Float?
  valorUnitResultado  Float
  valorTotal          Float?
  modalidade          String?
  codigoModalidade    String?
  data                DateTime
  uf                  String?
  municipio           String?
  orgao               String?
  cnpjOrgao           String?
  fornecedor          String?
  cnpjFornecedor      String?
  numeroControlePncp  String?

  @@index([descricaoNorm])
  @@index([data])
  @@index([uf])
  @@index([codItemCatalogo])
  @@schema("public")
}

model RelatorioGerado {
  id           String   @id @default(cuid())
  tipo         String   // PESQUISA_PRECO | ARP | RISCO | EXECUTIVO
  parametros   Json
  nomeArquivo  String
  tamanhoBytes Int?
  geradoPorId  String
  geradoPor    User     @relation(fields: [geradoPorId], references: [id], onDelete: Cascade)
  criadoEm     DateTime @default(now())
  emailEnviado Boolean  @default(false)
  emailDest    String?

  @@index([geradoPorId])
  @@index([tipo])
  @@index([criadoEm])
  @@schema("public")
}
